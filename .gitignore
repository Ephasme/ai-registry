# Secrets — never commit (see CLAUDE.md "Forbidden")
.credentials.json
*.credentials.json
*.pem
*.key
.env
.env.*
# payment-qr skill registry — holds beneficiary IBANs, must stay local
beneficiaries.json
# receipt-splitwise card→person map — holds CB last-4s, must stay local
receipt-cards.json
# Plaintext Google OAuth client secrets — only the sops-encrypted *.sops.json is committed
google_creds*.json
google-secrets*.json
*-secrets.json
client_secret_*.json
*.apps.googleusercontent.com.json
# Any plaintext secret dropped into secrets/ stays local; only the *.sops.json ciphertext is committed
secrets/*.json
!*.sops.json

# Volatile / local Claude state
.claude.json
.claude/settings.local.json
*.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python bytecode cache (skill scripts)
__pycache__/
*.pyc
