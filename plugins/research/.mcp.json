{
  "mcpServers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${user_config.EXA_API_KEY}"
      }
    },
    "playwright": {
      "type": "http",
      "url": "https://mcp.loup-peluso.com/playwright/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.CF_ACCESS_CLIENT_SECRET}"
      }
    }
  }
}
