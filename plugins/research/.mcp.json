{
  "mcpServers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${user_config.EXA_API_KEY}"
      }
    },
    "playwright": {
      "type": "http",
      "url": "https://playwright.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.PLAYWRIGHT_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.PLAYWRIGHT_CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "brightdata": {
      "type": "http",
      "url": "https://brightdata.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.BRIGHTDATA_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.BRIGHTDATA_CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "apify": {
      "type": "http",
      "url": "https://mcp.apify.com/",
      "headers": {
        "Authorization": "Bearer ${user_config.APIFY_API_TOKEN}"
      }
    }
  }
}
