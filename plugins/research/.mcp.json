{
  "mcpServers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${user_config.EXA_API_KEY}"
      }
    },
    "playwright": {
      "type": "http",
      "url": "https://playwright.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.PLAYWRIGHT_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.PLAYWRIGHT_CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "brightdata": {
      "command": "npx",
      "args": ["@brightdata/mcp"],
      "env": {
        "API_TOKEN": "${user_config.BRIGHTDATA_API_KEY}",
        "GROUPS": "advanced_scraping,ecommerce,browser,research,travel"
      }
    }
  }
}
