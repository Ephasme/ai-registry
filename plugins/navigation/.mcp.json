{
  "mcpServers": {
    "google-maps": {
      "type": "http",
      "url": "https://maps.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.MAPS_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.MAPS_CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "tesla": {
      "type": "http",
      "url": "https://tesla.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.TESLA_CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.TESLA_CF_ACCESS_CLIENT_SECRET}"
      }
    }
  }
}
