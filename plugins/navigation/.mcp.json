{
  "mcpServers": {
    "google-maps": {
      "type": "http",
      "url": "https://mcp.loup-peluso.com/maps/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "tesla": {
      "type": "http",
      "url": "https://mcp.loup-peluso.com/tesla/mcp",
      "headers": {
        "CF-Access-Client-Id": "${user_config.CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${user_config.CF_ACCESS_CLIENT_SECRET}"
      }
    }
  }
}
